# MongoDB Connection URI (optional: if omitted or unconnectable, automatic in-memory fallback is active)
MONGODB_URI=mongodb://localhost:27017/jari_loyalty

# JWT Secret for Session Signing
JWT_SECRET=jari_coffee_house_super_secure_secret_loyalty_2026_jwt_token

# White-Label Default Store Configuration
NEXT_PUBLIC_DEFAULT_STORE_NAME=jari
NEXT_PUBLIC_DEFAULT_TAGLINE=Coffee House & Pastry
NEXT_PUBLIC_DEFAULT_CURRENCY=JOD
NEXT_PUBLIC_DEFAULT_POINTS_PER_UNIT=10
NEXT_PUBLIC_DEFAULT_DISCOUNT_PER_100_PTS=1.00
NEXT_PUBLIC_DEFAULT_BRAND_COLOR=#0A52A9
NEXT_PUBLIC_DEFAULT_ACCENT_COLOR=#F4EECF

# Google OAuth Credentials (for customer login & signup)
GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@jari.com
